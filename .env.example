# Telegram Bot Token von @BotFather
TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# AI Provider: "anthropic" (direkt) oder "openrouter"
AI_PROVIDER=anthropic

# Anthropic API Key (wenn AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter API Key (wenn AI_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-...

# AI Modell (optional – Standard: claude-sonnet-4 bei Anthropic, anthropic/claude-sonnet-4 bei OpenRouter)
# AI_MODEL=

# Deine Telegram Chat-ID(s) – kommagetrennt (mehrere möglich)
# Ermittelbar via @userinfobot
ALLOWED_CHAT_IDS=123456789
